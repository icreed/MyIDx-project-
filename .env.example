# ---------------------------------------------------------------------------
# MyIDx environment template. Copy to .env and fill in real values.
# NEVER commit a populated .env — .gitignore excludes it deliberately.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myidx?schema=public
REDIS_URL=redis://localhost:6379

# --- Platform auth (JWT + refresh tokens) -----------------------------------
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Encryption at rest (AES-256-GCM, per-user derived keys) -----------------
# 32-byte key, base64 encoded: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# --- MFA / TOTP -------------------------------------------------------------
TOTP_ISSUER=MyIDx

# --- Identity verification (Sumsub) -----------------------------------------
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# --- Payments ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYSTACK_SECRET_KEY=

# --- OAuth 2.0 (MyIDx SDK for merchants) ------------------------------------
OAUTH_ISSUER_URL=http://localhost:4000
OAUTH_AUTH_CODE_TTL=600

# --- App URLs ---------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
USER_APP_URL=http://localhost:3000
MERCHANT_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
